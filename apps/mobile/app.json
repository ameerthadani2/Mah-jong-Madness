{
  "expo": {
    "name": "Mahjong Madness",
    "slug": "mahjong-madness",
    "scheme": "mahjongmadness",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#5BC8F5"
    },
    "ios": {
      "bundleIdentifier": "com.mahjongmadness.app",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ],
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      },
      "buildNumber": "1",
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "com.mahjongmadness.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#5BC8F5"
      },
      "versionCode": 1
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {},
    "icon": "./assets/icon.png",
    "description": "Taiwanese 16-tile Mahjong against bots or friends, with private clubs, shuffles every player verifies and a built-in coach.",
    "primaryColor": "#5BC8F5",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
