{
  "expo": {
    "name": "Mahjong Madness",
    "slug": "mahjong-madness",
    "scheme": "mahjongmadness",
    "version": "0.1.0",
    "orientation": "landscape",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#5BC8F5"
    },
    "ios": {
      "bundleIdentifier": "com.mahjongmadness.app",
      "supportsTablet": true,
      "requireFullScreen": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ],
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ],
        "NSLocalNetworkUsageDescription": "Mahjong Madness connects to a game host on your local network when you play with friends nearby."
      },
      "buildNumber": "1",
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "com.mahjongmadness.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#5BC8F5"
      },
      "versionCode": 1
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "signalUrl": "wss://signal.mahjongmadness.example/ws"
    },
    "icon": "./assets/icon.png",
    "description": "Peer-to-peer Taiwanese 16-tile Mahjong with private clubs, provably fair shuffles and a built-in coach.",
    "primaryColor": "#5BC8F5"
  }
}
