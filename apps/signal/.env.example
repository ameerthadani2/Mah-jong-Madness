# Signal server environment. Copy to apps/signal/.env for local use (it is gitignored); on Fly
# set each secret with `fly secrets set NAME=value`. Everything is optional: with nothing set the
# server runs with in-memory storage, guest-only sign-in and a warning. (DATA_DIR is no longer
# used: clubs and tables live in the database; the server only warns when it is still set.)
# Every variable the server and its smoke test read is named in this file
# (test/env-example.test.ts checks it).

# --- Production switches ---------------------------------------------------------------------
# NODE_ENV=production (fly.toml and the Docker image set it) makes the server fail closed: it
# refuses to start without DATABASE_URL and AUTH_PEPPER. Leave it unset for local development.
# NODE_ENV=production
# With NODE_ENV=production, 1 starts the server without a database or pepper on purpose
# (in-memory storage, random pepper: everything is lost at each restart). Never in production.
ALLOW_EPHEMERAL=

# --- Network -------------------------------------------------------------------------------
PORT=8787
# Take the client IP from x-forwarded-for. Set to 1 behind Fly's proxy; never on a bare host.
TRUST_PROXY=0
# Browser origins allowed to call the HTTP API (comma-separated). Native apps are not affected.
CORS_ORIGINS=
HOST_TABLES=1
MAX_HOSTED_TABLES=500
# Unfinished tables one account may have open at once (1 to 100).
MAX_TABLES_PER_USER=3
# How long a quick-match group short of four waits before bots fill its seats (ms, up to 600000).
QUICK_MATCH_FILL_MS=20000
# Relay-only rooms hosted by a player's device. Development only.
P2P_ROOMS=0

# --- App gate --------------------------------------------------------------------------------
# Oldest app build allowed online (GET /api/config.minBuild); 0 lets every build in.
MIN_BUILD=0
# When set, the app shows this notice instead of online play (GET /api/config.maintenance).
MAINTENANCE_MESSAGE=

# --- Database (Neon Postgres) --------------------------------------------------------------
# Pooled connection string (host contains "-pooler"), used by the running server.
DATABASE_URL=
# Direct (unpooled) connection string, used for migrations. Falls back to DATABASE_URL.
DATABASE_URL_DIRECT=
# Apply pending migrations before the server starts. fly.toml also runs them as a release command.
MIGRATE_ON_BOOT=0
# Folder holding the *.sql migrations. Leave empty: the default is the folder shipped with the
# code (apps/signal/migrations, or ./migrations next to the production bundle).
MIGRATIONS_DIR=
# Only for `npm test`: a database the tests may create and drop schemas in.
DATABASE_URL_TEST=

# --- Accounts --------------------------------------------------------------------------------
# Secret mixed into every stored session and guest-secret hash. 32+ random bytes, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep a copy: without it every session ends and every guest account is locked out for good.
AUTH_PEPPER=
# After rotating the pepper, the old value goes here (several: newest first, comma-separated).
# Sessions and guest secrets stored under it are still accepted and are stored again under
# AUTH_PEPPER when next presented. Keep it for at least 30 days (the session lifetime) and in
# practice for good: a guest who has not signed in again since the rotation is locked out once it
# is removed (docs/DEPLOY.md, "Rotating the pepper").
AUTH_PEPPER_PREVIOUS=
# Sign in with Apple: the app's bundle id (and the Services ID if web sign-in is added).
APPLE_CLIENT_ID=
# Google OAuth client ids for iOS, Android and web, comma-separated.
GOOGLE_CLIENT_IDS=
# Facebook Limited Login, server side only: the app has no Facebook button yet, so leave it empty.
FACEBOOK_APP_ID=
# Bearer token for /api/admin/* (support grants, reports, bans, mutes). 32+ random bytes; keep a
# copy. Empty: those routes answer 503.
ADMIN_TOKEN=

# --- Store (Phase 4) -------------------------------------------------------------------------
# RevenueCat webhook: set the Authorization header in the RevenueCat dashboard to
# "Bearer <this value>". Empty: the webhook answers 503 and /api/config.storeEnabled is false.
# Setting it makes the store live: from then on creating a club needs The Four Winds Club, so set
# it only when the products can be bought.
REVENUECAT_WEBHOOK_SECRET=
# RevenueCat secret API key (never in the app), for reconciliation after Restore and nightly.
# Empty: Restore only returns the wallet (synced: false) and no nightly reconciliation runs.
REVENUECAT_SECRET_KEY=
# Account ids (Settings -> Account -> Player id) whose sandbox purchases are granted,
# comma-separated. Empty: every sandbox purchase is recorded and ignored.
TESTER_USER_IDS=

# --- Push and observability (Phase 6) --------------------------------------------------------
# Expo access token for push notifications. Empty: no push is sent (pushEnabled false).
EXPO_ACCESS_TOKEN=
# Sentry DSN for server errors. Empty: errors are only logged.
SENTRY_DSN=
# Sentry environment name (default production).
SENTRY_ENVIRONMENT=
# Sentry release name. Leave empty on Fly: the image reference (FLY_IMAGE_REF, set by Fly on every
# machine and also shown as /health.image) is used.
SENTRY_RELEASE=
# PostHog project key for server events (purchase_credited, report_filed). Empty: none are sent.
POSTHOG_KEY=
# PostHog host; empty means PostHog's US cloud. EU: https://eu.i.posthog.com
POSTHOG_HOST=

# --- Smoke test (npm run smoke -w @mjm/signal) -----------------------------------------------
# Read by scripts/smoke.ts, not by the server. The address to test when none is given on the
# command line, and the storage /health must report (pg or memory; the same as --expect-storage).
SMOKE_URL=
SMOKE_EXPECT_STORAGE=
