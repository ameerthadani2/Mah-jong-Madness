{
  "name": "@mjm/signal",
  "version": "0.1.0",
  "private": true,
  "description": "Game server for Mahjong Madness: hosts every online table, relays the players' sockets and runs the clubs and accounts API.",
  "type": "module",
  "scripts": {
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "migrate": "tsx src/main.ts migrate",
    "build": "esbuild src/main.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/server.cjs --sourcemap --legal-comments=none --external:pg-native --external:bufferutil --external:utf-8-validate --define:import.meta.url=__mjm_import_meta_url \"--banner:js=const __mjm_import_meta_url = require('node:url').pathToFileURL(__filename).href;\"",
    "start:prod": "node --enable-source-maps dist/server.cjs"
  },
  "dependencies": {
    "@mjm/engine": "*",
    "@mjm/net": "*",
    "jose": "^6.2.15",
    "pg": "^8.23.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.25.12",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
