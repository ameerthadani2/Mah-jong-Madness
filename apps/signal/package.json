{
  "name": "@mjm/signal",
  "version": "0.1.0",
  "private": true,
  "description": "Tiny WebSocket signaling + relay server for Mahjong Madness rooms. Optionally hosts tables as a neutral party.",
  "type": "module",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@mjm/engine": "*",
    "@mjm/net": "*",
    "jose": "^6.2.15",
    "pg": "^8.23.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.25.12",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
