{
  "name": "mahjongmania",
  "private": true,
  "version": "0.1.0",
  "description": "Taiwanese (16-tile) Mahjong for iOS and Android with verifiable server-hosted tables and a built-in coach.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm run test -w @mjm/engine -w @mjm/net -w @mjm/signal -w @mjm/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "mobile": "npm run start -w @mjm/mobile",
    "signal": "npm run start -w @mjm/signal",
    "sim": "npm run sim -w @mjm/engine --",
    "mobile:tunnel": "npm run start -w @mjm/mobile -- --tunnel",
    "ios": "npm run ios -w @mjm/mobile",
    "ios:build": "cd apps/mobile && eas build --platform ios --profile preview",
    "ios:submit": "cd apps/mobile && eas submit --platform ios --latest",
    "i18n:check": "npm run i18n:check -w @mjm/mobile"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "typescript-eslint": "^8.72.1"
  }
}
